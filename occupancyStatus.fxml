<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="OccupancyStatusController"
      alignment="CENTER"
      spacing="18"
      prefWidth="500"
      prefHeight="400"
      style="-fx-padding: 50; -fx-background-color: #f5f5f5;">

    <Label text="Occupancy Status"
           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>

    <Label fx:id="capacityLabel"
           text=""
           style="-fx-font-size: 14; -fx-text-fill: #444;"/>

    <TableView fx:id="vehicleTable" prefHeight="300" prefWidth="400">
        <columns>
            <TableColumn fx:id="licensePlateColumn" text="License Plate" prefWidth="200"/>
            <TableColumn fx:id="entryTimeColumn" text="Entry Time" prefWidth="200"/>
        </columns>
    </TableView>

</VBox>