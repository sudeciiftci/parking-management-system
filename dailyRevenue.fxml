<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="DailyRevenueController"
      alignment="CENTER"
      spacing="18"
      prefWidth="600"
      prefHeight="500"
      style="-fx-padding: 50; -fx-background-color: #f5f5f5;">

    <Label text="Daily Revenue"
           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #534AB7;"/>

    <Label fx:id="totalRevenueLabel"
           text="Total Revenue: "
           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #534AB7;"/>

    <TableView fx:id="revenueTable" prefHeight="350" prefWidth="500">
        <columns>
            <TableColumn fx:id="licensePlateColumn" text="License Plate" prefWidth="150"/>
            <TableColumn fx:id="entryTimeColumn" text="Entry Time" prefWidth="160"/>
            <TableColumn fx:id="exitTimeColumn" text="Exit Time" prefWidth="160"/>
            <TableColumn fx:id="feeColumn" text="Fee" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>