<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="VehicleEntryController"
      alignment="CENTER"
      spacing="18"
      prefWidth="500"
      prefHeight="400"
      style="-fx-padding: 50; -fx-background-color: #f5f5f5;">

    <Label text="Vehicle Entry"
           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1D9E75;"/>

    <HBox spacing="12" alignment="CENTER">
        <TextField fx:id="licensePlateField"
                   promptText="Enter license plate"
                   prefWidth="280"
                   prefHeight="40"
                   style="-fx-font-size: 14;"/>
        <Button text="Search"
                onAction="#searchVehicle"
                prefHeight="40"
                style="-fx-background-color: #1D9E75; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
    </HBox>

    <Label fx:id="messageLabel"
           text=""
           style="-fx-font-size: 14;"/>

    <VBox fx:id="vehicleFormBox"
          spacing="14"
          alignment="CENTER"
          visible="false"
          managed="false">

        <ComboBox fx:id="typeComboBox"
                  promptText="Vehicle type"
                  prefWidth="320"
                  prefHeight="40"
                  style="-fx-font-size: 14;"/>

        <TextField fx:id="brandField"
                   promptText="Brand"
                   prefWidth="320"
                   prefHeight="40"
                   style="-fx-font-size: 14;"/>

        <TextField fx:id="modelField"
                   promptText="Model"
                   prefWidth="320"
                   prefHeight="40"
                   style="-fx-font-size: 14;"/>

        <TextField fx:id="colorField"
                   promptText="Color"
                   prefWidth="320"
                   prefHeight="40"
                   style="-fx-font-size: 14;"/>

        <Button text="Save Vehicle"
                onAction="#saveVehicle"
                prefWidth="320"
                prefHeight="40"
                style="-fx-background-color: #1D9E75; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>

    </VBox>

</VBox>